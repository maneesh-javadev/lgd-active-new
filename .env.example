# LGD 2.0 Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION VALUES TO VERSION CONTROL

# Database Credentials
SPRING_DATASOURCE_USERNAME=lgd_prod_user
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Redis Credentials (Authenticated Redis with requirepass)
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Eureka Discovery Service
EUREKA_USERNAME=eureka_admin
EUREKA_PASSWORD=REPLACE_WITH_STRONG_EUREKA_PASSWORD

# Cryptographic Keys (RS256 / JWKS)
JWT_RSA_KEY_ID=lgd-key-2026-1
JWT_RSA_PRIVATE_KEY_PATH=/run/secrets/jwt_rsa_private.key
JWT_RSA_PUBLIC_KEY_PATH=/run/secrets/jwt_rsa_public.pem
JWT_LEGACY_HS256_ENABLED=false
JWT_JWKS_URI=http://auth-service:18090/.well-known/jwks.json
JWT_EXPIRATION=900000

# Legacy HMAC transition secret (only if JWT_LEGACY_HS256_ENABLED=true)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_OR_STRONG_SECRET_AT_LEAST_256_BITS

# eSign Service Credentials
ESIGN_ASP_ID=CDAC_ASP_ID
ESIGN_AUTH_KEY=REPLACE_WITH_ASP_AUTH_KEY
ESIGN_KEYSTORE_PATH=/run/secrets/esign_keystore.p12
ESIGN_KEYSTORE_PASSWORD=REPLACE_WITH_STRONG_KEYSTORE_PASSWORD
ESIGN_ALIAS=lgd_esign_signer
ESIGN_ESP_CERT_PATH=/etc/ssl/certs/cdac_trust_anchor.cer
ESIGN_ALLOW_UNSIGNED_FALLBACK=false
