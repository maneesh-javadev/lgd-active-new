# LGD 2.0 Environment Configuration Template
# DO NOT COMMIT ACTUAL PRODUCTION VALUES TO VERSION CONTROL

# Database Credentials
SPRING_DATASOURCE_USERNAME=lgd_prod_user
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Redis Credentials
SPRING_DATA_REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# Eureka Discovery Service
EUREKA_USERNAME=eureka_admin
EUREKA_PASSWORD=REPLACE_WITH_STRONG_EUREKA_PASSWORD

# Cryptographic Keys (Must be >= 256 bits / 32 bytes hex or base64)
JWT_SECRET=REPLACE_WITH_64_CHAR_HEX_OR_STRONG_SECRET_AT_LEAST_256_BITS

# eSign Service Credentials
ESIGN_ASP_ID=CDAC_ASP_ID
ESIGN_AUTH_KEY=REPLACE_WITH_ASP_AUTH_KEY
ESIGN_KEYSTORE_PASSWORD=REPLACE_WITH_STRONG_KEYSTORE_PASSWORD
ESIGN_CERT_PATH=/etc/ssl/certs/cdac_trust_anchor.cer
